{
  "name": "whatsapp-sales-hub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:evolution": "docker compose -f docker-compose.dev.yml --profile evolution up -d",
    "setup": "pnpm install && pnpm --filter @sales-hub/shared build && pnpm --filter @sales-hub/api db:deploy && pnpm --filter @sales-hub/api db:seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify:prototype": "node scripts/verificar-prototipo.mjs",
    "test:prototype": "pnpm --filter @sales-hub/api exec dotenv -e ../../.env -- vitest run --config vitest.e2e.config.ts src/modules/admin-api/painel.service.e2e.test.ts src/modules/inbound/orquestrador-demo.e2e.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^16.3.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
