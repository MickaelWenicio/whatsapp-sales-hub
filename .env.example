# Ambiente (development | production | test)
NODE_ENV=development
# Papel do processo: web | worker (definido pelos scripts)
PROCESS_ROLE=
# Porta da API
PORT=3311
# URL publica base da API
APP_BASE_URL=http://localhost:3311
# Postgres (compose dev publica na 5436)
DATABASE_URL=postgresql://saleshub:saleshub@localhost:5436/saleshub?schema=public
# Redis (filas BullMQ)
REDIS_URL=redis://localhost:6379
# Debounce de mensagens do cliente antes de acionar o agente (ms)
AGENT_DEBOUNCE_MS=3000
# Teto maximo do debounce (ms)
AGENT_DEBOUNCE_MAX_MS=20000
# Maximo de mensagens do historico enviadas ao modelo
AGENT_HISTORICO_MAX=40
# Modelo do agente
AGENT_MODEL=claude-opus-5-5
# Esforco de raciocinio do agente
AGENT_EFFORT=low
# Chave da Anthropic (preenchida localmente)
ANTHROPIC_API_KEY=
# Nome da empresa que o agente representa (aparece no prompt e nas mensagens geradas)
EMPRESA_NOME=Empresa Exemplo
# O que a empresa oferece, em uma ou duas frases (entra no prompt do agente)
EMPRESA_DESCRICAO=Empresa de serviços por assinatura para pessoas e empresas.
# Termos que o agente nunca pode usar, separados por virgula (ex.: garantido,melhor do mercado).
# O filtro de saida bloqueia a bolha e o catalogo recusa textos com eles. Vazio = nenhum.
AGENT_TERMOS_PROIBIDOS=
# Conector de canal
CHANNEL_CONNECTOR=evolution
# URL da Evolution API
EVOLUTION_API_URL=http://localhost:8080
# Chave global da Evolution API
EVOLUTION_API_KEY=
# Nome da instancia Evolution
EVOLUTION_INSTANCE=sales-hub
# Token do webhook (query ?token=)
EVOLUTION_WEBHOOK_TOKEN=
# Token de administracao da API
ADMIN_API_TOKEN=
# Segredo de assinatura de sessao/JWT
AUTH_SECRET=
# Criptografia de PII em repouso
PII_ENCRYPTION_ENABLED=false
# Chave de criptografia de PII
PII_ENCRYPTION_KEY=
# Modo demo (restringe envios aos numeros permitidos)
DEMO_MODE=true
# Numeros permitidos na demo, E.164 separados por virgula
DEMO_ALLOWED_NUMBERS=
# Numero do agente (celular A) em E.164
NUMERO_AGENTE_E164=
# Dono criado pelo seed
SEED_DONO_NOME=
SEED_DONO_EMAIL=
SEED_DONO_SENHA=
# Nivel de log
LOG_LEVEL=info
